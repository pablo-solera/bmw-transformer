# App / queue
HOST=127.0.0.1
PORT=3005
REDIS_URL=redis://127.0.0.1:6379
STATE_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=52428800

# S3 compatible storage (shared values may match bmw-reader)
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_PREFIX=
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
S3_REQUEST_TIMEOUT_MS=30000

# Legacy compatibility
LEGACY_LOCALE=es-ES
LEGACY_ANSI_ENCODING=windows-1252
BMW_READER_GROUP=BMW

# SQL Server persistence for the legacy BMW labour table. Configure credentials
# through a secret manager or a local .env; never commit real values.
SQL_ENABLED=true
SQL_SERVER=
SQL_PORT=1433
SQL_INSTANCE=
SQL_DATABASE=BMW_Labour
SQL_TLS_SERVER_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=120000
SQL_POOL_MAX=4
