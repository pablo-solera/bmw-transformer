{
  "name": "bmw-transformer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "tedious": "19.2.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "test": "bun test && bun run test:flow",
    "test:flow": "bun test --config=bunfig.flow.toml tests/flow",
    "test:e2e": "bun run scripts/run-e2e-tests.ts",
    "test:sql": "bun run scripts/run-sql-integration-tests.ts",
    "check:sql": "bun run scripts/check-sql-connectivity.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@smithy/fetch-http-handler": "^5.8.0",
    "bullmq": "^5.58.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.6.1",
    "mssql": "^12.7.9",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
